{
  "name": "chat",
  "version": "0.1.13",
  "tablePrefix": "chat_",
  "notificationKinds": [
    {"id": "waiting", "label": "Live chats waiting for a reply", "description": "Visitors are waiting for somebody to answer them.", "dedupePrefix": "chat:unread"},
    {"id": "visitor-arrived", "label": "New visitor on the site", "description": "Somebody new has turned up on the site. Browser alert only, it never sits in the list.", "dedupePrefix": "chat:visitor-arrived"}
  ],
  "description": "Live Chat - a small, quick chat bubble for your site, with attachments, browser notifications for visitors, emailed transcripts and replies from the admin, the site itself or the Unified Inbox.",
  "requiresCoreVersion": "0.5.1779",
  "permissions": [
    "chat.view",
    "chat.reply",
    "chat.manage"
  ],
  "settingsTabs": [
    {
      "id": "chat",
      "label": "Live Chat",
      "permission": "chat.manage",
      "import": "./components/SettingsTab",
      "component": "ChatSettingsTab"
    }
  ],
  "extensionPoints": [
    {
      "point": "core.inbox-tabs",
      "id": "chat",
      "label": "Live chat",
      "order": 20,
      "permission": "chat.view",
      "import": "./components/InboxPanel",
      "component": "ChatInboxPanel"
    },
    {
      "point": "core.conversation-provider",
      "id": "chat",
      "label": "Live chat",
      "permission": "chat.view",
      "serverOnly": true,
      "import": "./lib/conversation-provider",
      "component": "chatConversationProvider"
    },
    {
      "point": "core.mobile-bar-items",
      "id": "chat-open",
      "label": "Live chat: message us",
      "import": "./components/ChatMobileBarItem",
      "component": "ChatMobileBarItem"
    },
    {
      "point": "core.media-private-storage",
      "id": "chat",
      "import": "./lib/media-private-storage",
      "component": "chatPrivateStorage"
    }
  ],
  "puckBlocks": [
    {
      "type": "ChatBubble",
      "import": "./components/ChatBlock",
      "rscImport": "./components/ChatBlock.rsc",
      "component": "chatBlockComponent",
      "rscComponent": "chatBlockRscComponent",
      "layoutTypes": [
        "header",
        "footer"
      ]
    }
  ],
  "cookieCategories": [
    {
      "key": "live-chat",
      "label": "Live chat",
      "description": "Lets the chat window remember your conversation with us, and lets us see which page you are on and what is in your basket so we can help - and say hello first. Nothing is shared with anyone else, and your trail around the site is deleted a week after your last visit."
    }
  ],
  "requiredEnvVars": [
    {
      "name": "ENCRYPTION_KEY",
      "required": true
    },
    {
      "name": "CRON_SECRET",
      "required": false
    }
  ],
  "teardown": [
    "chat_attachments",
    "chat_messages",
    "chat_conversations",
    "chat_visitors",
    "chat_settings"
  ],
  "cronJobs": [
    {
      "path": "/api/m/chat/cron/retention",
      "schedule": "47 2 * * *"
    }
  ]
}
